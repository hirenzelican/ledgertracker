# Copy to .env.local and fill in with values from your Supabase project
# (Supabase Dashboard -> Project Settings -> API).
#
# Both values below are PUBLIC by design: they are shipped to the browser and are
# safe to expose ONLY because Row Level Security is enabled on the transactions table.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# NEVER add SUPABASE_SERVICE_ROLE_KEY here or anywhere in this project.
# This app is a static client-side build: anything in it reaches the browser.
